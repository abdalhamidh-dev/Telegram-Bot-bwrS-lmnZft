# Environment example for Telegram group moderation bot

# قم بملء هذه القيم في Replit → Settings → Secrets (Environment variables)
# لا تُشارك هذه القيم علنًا (خصوصاً TELEGRAM_BOT_TOKEN و DATABASE_URL)

# قاعدة البيانات (Postgres)
DATABASE_URL=postgres://postgres:PASSWORD@db.random.supabase.co:5432/postgres

# توكن بوت تيليجرام (احصل عليه من @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# إذا تريد استخدام Replit connectors ضع القيمة true
USE_REPLIT_CONNECTORS=true

# مفتاح Sightengine (اختياري) — اتركه فارغًا إذا لم تستخدم الفحص
SIGHTENGINE_SECRET=

# رابط عام للوصول إلى لوحة الإعدادات (اختياري)
DASHBOARD_PUBLIC_URL=

# مستوى اللوق أثناء التطوير (اختياري)
LOG_LEVEL=debug
